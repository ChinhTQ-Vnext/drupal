	<!-- pageArea -->
	<div
		id="pageArea">
		<!-- pageNaviTop -->
		<div class="clearfix" id="pageNaviTop">
			<ul class="clearfix">
				<li class="act">
					<a href="">概要・特長</a>
				</li>

