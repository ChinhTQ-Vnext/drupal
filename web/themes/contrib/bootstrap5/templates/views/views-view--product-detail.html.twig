				<div class="outer">
					<h2 id="{{key + 1}}" class="subtitle">
						<span>{{field_feature.entity.field_title.value}}</span>
					</h2>
					<div class="inner">
						{{field_feature.entity.field_content.value|raw}}
					</div>
				</div>
			{% endfor %}
			<!-- //outer// -->
			<!-- //outer// -->
			<ul class="tgNaviBottom clearfix">
				<li>
					<a class="closeFea" href="#">全て閉じる</a>
				</li>
				<li class="lastChild">
					<a class="openFea" href="#">特長を全て開く</a>
				</li>
			</ul>
		</div>
		<!-- /featureArea -->
