<div id="contentsMain">
	<!-- pageTtl -->
	<div class="cClear clearfix ttlBtn" id="pageTtl">
		<h1>
			<span class="caption">{{product_spec.field_product.entity.field_caption.value}}</span>
			{{product_spec.field_product.entity.field_product_name.value}}</h1>
		<a id="cLnk_spf" href="#" target="_blank" class="gaSpfLink_dg"><img src="/sites/default/files/2025-04/btn_print.gif" alt="仕様書印刷" onclick="openwin_forPrint();"></a>
	</div>
	<!-- /pageTtl -->
	<!-- socialBtn -->
	<div
		class="clearfix" id="socialBtn">
		<!-- はてなブックマーク -->
		<div id="hatena">
			<iframe class="hatena-bookmark-button-frame" title="このエントリーをはてなブックマークに追加" width="86" height="20" src="javascript:false" style="width: 86px; height: 20px; border: none;"></iframe>
			<script type="text/javascript" src="https://b.st-hatena.com/js/bookmark_button.js" charset="utf-8" async="async"></script>
		</div>
		<!-- mixi -->
		<div id="mixi">
			<span>
				<iframe id="mixi-check-iframe7737" src="https://static.mixi.jp/share_button.html?u=https%3A%2F%2Fwww.iodata.jp%2Fproduct%2Fhdd%2Frokuga%2Favhd-wru%2F&amp;k=1bdd95d221df16da93d80378fd9c30538eaff97e&amp;b=button-1&amp;m=https%3A%2F%2Fmixi.jp%2F" frameborder="0" scrolling="no" allowtransparency="true" style="overflow: hidden; border: 0px; height: 20px; width: 60px;"></iframe>
			</span>
			<script type="text/javascript" src="//static.mixi.jp/js/share.js"></script>
		</div>
		<!-- Twitter -->
		<div id="twitter">
			<iframe id="twitter-widget-0" scrolling="no" frameborder="0" allowtransparency="true" allowfullscreen="true" class="twitter-share-button twitter-share-button-rendered twitter-tweet-button" title="X Post Button" src="https://platform.twitter.com/widgets/tweet_button.2f70fb173b9000da126c79afe2098f02.ja.html#dnt=false&amp;id=twitter-widget-0&amp;lang=ja&amp;original_referer=https%3A%2F%2Fwww.iodata.jp%2Fproduct%2Fhdd%2Frokuga%2Favhd-wru%2F&amp;size=m&amp;text=24%E6%99%82%E9%96%93%E9%80%A3%E7%B6%9A%E9%8C%B2%E7%94%BB%E5%AF%BE%E5%BF%9C%E3%80%80%E3%83%8F%E3%82%A4%E3%82%A8%E3%83%B3%E3%83%89%E3%83%A2%E3%83%87%E3%83%AB%E3%81%AE%E9%8C%B2%E7%94%BB%E7%94%A8%E3%83%8F%E3%83%BC%E3%83%89%E3%83%87%E3%82%A3%E3%82%B9%E3%82%AF%E3%80%8CAVHD-WR%2FU%E3%82%B7%E3%83%AA%E3%83%BC%E3%82%BA%E3%80%8D&amp;time=1745218833256&amp;type=share&amp;url=https%3A%2F%2Fwww.iodata.jp%2Fproduct%2Fhdd%2Frokuga%2Favhd-wru%2Findex.htm%2Findex.jsp" style="position: static; visibility: visible; width: 77px; height: 20px;" data-url="https://www.iodata.jp/product/hdd/rokuga/avhd-wru/index.htm/index.jsp"></iframe>
			<script type="text/javascript" src="//platform.twitter.com/widgets.js"></script>
		</div>
		<!-- Facebook -->
		<div id="facebook">
			<iframe src="//www.facebook.com/v2.0/plugins/like.php?app_id=208737769174526&amp;href=https%3A%2F%2Fwww.iodata.jp%2Fproduct%2Fhdd%2Frokuga%2Favhd-wru%2Findex.htm%2Findex.jsp&amp;send=false&amp;layout=button&amp;width=110&amp;show_faces=false&amp;action=like&amp;colorscheme=light&amp;font&amp;height=21" scrolling="no" style="border: currentColor; width: 110px; height: 21px; overflow: hidden;" allowtransparency="true" frameborder="0"></iframe>
		</div>
	</div>
	<!-- /socialBtn -->
	<!-- pageArea -->
	<div
		id="pageArea">
		<!-- pageNaviTop -->
		<div class="clearfix" id="pageNaviTop">
			<ul class="clearfix">
				<li>
					<a href="{{product_spec.field_product.entity.field_url.uri}}">概要・特長</a>
				</li>

				<li class="act">
					<a href="">ギャラリー・仕様</a>
				</li>

			</ul>
		</div>
		<!-- /pageNaviTop -->
		<!-- outlineArea -->
		<div id="outlineArea"></div>
		<!-- /outlineArea -->
		<!-- featureArea -->
		<div class="swiper main-slider mb-4">
			<div class="swiper thumb-slider">
				<div class="swiper-wrapper swiper-thumbnail">
					{% for image in product_spec.field_spec_carousel %}
						{% set file = image.entity.field_media_image.entity %}
						{% if file %}
							<div class="swiper-slide">
								<img src="{{ file.uri.value | image_style('thumbnail') }}" alt="{{ file.filename.value }}">
							</div>
						{% endif %}
					{% endfor %}
				</div>
			</div>
			<div class="swiper-wrapper swiper-large">
				{% for image in product_spec.field_spec_carousel %}
					{% set file = image.entity.field_media_image.entity %}
					{% if file %}
						<div class="swiper-slide">
							<img src="{{ file.uri.value | image_style('large') }}">
						</div>
					{% endif %}
				{% endfor %}
			</div>
		</div>
		<div id="featureArea">
			<div id="galleryArea"></div>
		</div>
		<!-- HC_CONTENT_GaiyoList_s6175 end -->

	</div>
	<!-- /otherArea -->
	<!-- pageNaviBtm -->
	<div class="clearfix" id="pageNaviBtm">
		<ul class="clearfix">
			<li>
				<a href="{{product_spec.field_product.entity.field_url.uri}}">概要・特長</a>
			</li>

			<li class="act">
				<a href="">ギャラリー・仕様</a>
			</li>

		</ul>
	</div>
	<!-- /pageNaviBtm -->
</div>
<!-- /pageArea --></div>
