<div
	id="contentsMain">
	<!-- pageTtl -->
	{% set parent = terms['parent'] %}
	{% set childs = terms['childs'] %}
	<div id="pageTtl">
		<h1>{{title}}</h1>
	</div>
	<!-- ===== Content ===== Start -->
	<!-- pageTtl -->
	<!-- main-area -->
		<div id="main-area"> <div id="main-visual">
			<div id="hero" class="carousel slide" data-bs-ride="carousel">
				<div class="carousel-inner">
					{% for key, image in parent.field_carousel %}
						<div class="carousel-item {{key == 0 ? 'active' : ''}}">
							<img src="{{ file_url(image.entity.field_media_image.entity.uri.value) }}">
						</div>
					{% endfor %}
				</div>

				<button class="carousel-control-prev" type="button" data-bs-target="#hero" data-bs-slide="prev">
					<span class="carousel-control-prev-icon" aria-hidden="true"></span>
					<span class="visually-hidden">Previous</span>
				</button>
				<button class="carousel-control-next" type="button" data-bs-target="#hero" data-bs-slide="next">
					<span class="carousel-control-next-icon" aria-hidden="true"></span>
					<span class="visually-hidden">Next</span>
				</button>
			</div>
		</div>
	</div>
	<!-- /main-area -->
	<!-- categoryNavi -->
	<div class="userNavi" id="categoryNavi">
		<div class="clearfix" id="categoryNaviTtlArea">
			<h2>商品カテゴリー</h2>
		</div>
		<!--ここから-->
		<div class="userNaviArea clearfix box4clm" style="padding-bottom: 15px; border-bottom: 1px solid #000;">
			{% for term in childs %}
				<dl>
					<dt>
						<span>{{term.field_note.value}}</span>
					</dt>
					<dd>
						<a href="{{term.url_redirect}}">
							<span class="boxPhoto"><img src="{{file_url(term.field_icon.entity.field_media_image.entity.uri.value)}}" alt="{{term.name.value}}" class="photo" width="100" height="77"></span>
							<span>
								<strong>{{term.name.value}}</strong>
							</span>
						</a>
					</dd>
				</dl>
			{% endfor %}
		</div>
		<!--ここまで-->
	</div>
